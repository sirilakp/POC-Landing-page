@model IReadOnlyList<GuestUser>
@{
    ViewData["Title"] = "Manage Users";
    var spId = ViewBag.ServicePrincipalId as string ?? "";
    var portalUsersUrl = $"https://portal.azure.com/#view/Microsoft_AAD_IAM/ManagedAppMenuBlade/~/Users/objectId/{spId}/appId//defaultBlade/Overview";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage Users</h1>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Invite a new user</h5>
        <form id="invite-form" class="row g-2">
            <div class="col-md-8">
                <input type="email" class="form-control" id="invite-email" placeholder="user@inholland.nl" required />
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-primary">Send invitation</button>
            </div>
        </form>
        <div id="invite-status" class="mt-2 small"></div>
        <p class="text-muted small mt-2 mb-0">After the user accepts the invitation, assign their role in the <a href="https://portal.azure.com" target="_blank">Azure Portal</a> under Enterprise Applications → Users and groups.</p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Current users</h5>
    <div class="d-flex gap-2 align-items-center">
        <input type="search" id="user-search" class="form-control form-control-sm" placeholder="Search name or email…" style="width:220px" />
        <select id="page-size" class="form-select form-select-sm" style="width:auto">
            <option value="10" selected>10 / page</option>
            <option value="25">25 / page</option>
            <option value="50">50 / page</option>
        </select>
    </div>
</div>

<table class="table table-striped" id="users-table">
    <thead>
        <tr>
            <th>Display name</th>
            <th>Email</th>
            <th>Type</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr data-name="@user.DisplayName.ToLowerInvariant()" data-email="@user.Email.ToLowerInvariant()"
            data-invite-status="@user.InviteStatus" data-role="@user.Role" data-user-email="@user.Email">
            <td>@user.DisplayName</td>
            <td>@user.Email</td>
            <td>
                @if (user.IsExternal)
                {
                    <span class="badge text-bg-secondary">External</span>
                }
                else
                {
                    <span class="badge text-bg-primary">Internal</span>
                }
            </td>
            <td>
                @if (user.Role == "Default access")
                {
                    <span class="text-muted small">Default access</span>
                }
                else
                {
                    <span>@user.Role</span>
                }
            </td>
            <td>
                @if (user.InviteStatus == "PendingAcceptance")
                {
                    <span class="badge text-bg-warning text-dark">Invite Sent</span>
                }
                else if (user.InviteStatus == "Accepted" || user.InviteStatus == "Member")
                {
                    <span class="badge text-bg-success">@user.InviteStatus</span>
                }
                else
                {
                    @user.InviteStatus
                }
            </td>
            <td class="text-nowrap">
                @if (user.InviteStatus == "PendingAcceptance")
                {
                    <button class="btn btn-sm btn-outline-secondary resend-invite" data-email="@user.Email">Resend Invite</button>
                }
                else if (user.InviteStatus == "Accepted" && (user.Role == "Default access" || string.IsNullOrEmpty(user.Role)))
                {
                    <a href="@portalUsersUrl" target="_blank" rel="noopener" class="btn btn-sm btn-primary">Assign in Portal ↗</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-2">
    <span id="pagination-info" class="text-muted small"></span>
    <nav>
        <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
    </nav>
</div>

@section Scripts {
    <script src="~/js/invitations.js" asp-append-version="true"></script>
}
