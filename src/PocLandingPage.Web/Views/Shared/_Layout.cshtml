@{
    var isAdmin = User.IsInRole(Roles.Admin);
    var role = isAdmin ? "POC Admin" : (User.IsInRole(Roles.Viewer) ? "POC Viewer" : "");
    var isLocalDevAuth = string.Equals(User.Identity?.AuthenticationType, "LocalDevAuth", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inholland POC Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName.TrimStart().Substring(0, 1).ToUpperInvariant();
}
<header>
    <nav class="navbar navbar-expand-md poc-nav">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo">inh</span>
                <span>POC Portal</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 ms-md-3">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">POCs</a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/pocs">Manage POCs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/invitations">Manage Users</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav align-items-md-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="role-badge">@role</span>
                        </li>
                        <li class="nav-item d-none d-md-block user-name">
                            @userName
                        </li>
                        if (!isLocalDevAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">Sign out</a>
                            </li>
                        }
                        <li class="nav-item">
                            <span class="avatar" title="@userName">@initial</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer text-center">
    <div class="container">
        Built for <b>Inholland</b> &mdash; POC Portal &copy; @DateTime.UtcNow.Year
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
