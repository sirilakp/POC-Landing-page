@model IReadOnlyList<PocEntry>
@{
    ViewData["Title"] = "POCs";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Available POCs</h1>
    @if (isAdmin)
    {
        <a href="/admin/pocs" class="btn btn-primary btn-sm">Manage POCs</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @if (isAdmin)
        {
            <span>No POCs yet. <a href="/admin/pocs">Add one</a>.</span>
        }
        else
        {
            <span>No POCs have been shared with you yet. Contact an administrator if you expected access.</span>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var poc in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@poc.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@poc.Description</p>
                        <a href="@poc.Url" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm align-self-start">
                            Open POC →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
